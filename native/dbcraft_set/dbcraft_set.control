# dbcraft_set: optional native accelerator for dbcraft: the iteration order of fastutil's ShortOpenHashSet and the packet templates built from it.
comment = 'dbcraft: ShortOpenHashSet iteration order and fill packet templates'
default_version = '1.0'
module_pathname = '$libdir/dbcraft_set'
relocatable = false
schema = dbcraft_set
superuser = true
trusted = false
